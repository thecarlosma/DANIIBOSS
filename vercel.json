{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "daniiboss.vercel.app"
        }
      ],
      "destination": "https://daniiboss.com/:path*",
      "permanent": true
    },
    {
      "source": "/boss",
      "destination": "/boss/",
      "permanent": true
    },
    {
      "source": "/orden",
      "destination": "/orden/",
      "permanent": true
    }
  ]
}
